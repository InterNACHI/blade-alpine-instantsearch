{
	"name": "internachi/blade-alpine-instantsearch",
	"description": "Algolia instant search as Blade/Alpine.js components",
	"keywords": [
		"laravel",
		"algolia",
		"instantsearch"
	],
	"type": "library",
	"license": "MIT",
	"autoload": {
		"psr-4": {
			"InterNACHI\\BladeInstantSearch\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"InterNACHI\\BladeInstantSearch\\Tests\\": "tests/"
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"laravel": {
			"providers": [
				"InterNACHI\\BladeInstantSearch\\Providers\\BladeInstantSearchProvider"
			]
		}
	},
	"require": {
		"php": "^8.1",
		"illuminate/view": "^10|^11|^12|^13",
		"illuminate/support": "^10|^11|^12|^13"
	},
	"require-dev": {
		"orchestra/testbench": "^8.37|^9.16|^10.11|^11.0",
		"phpunit/phpunit": "^10.5|^11.5|^12.5",
		"friendsofphp/php-cs-fixer": "^3.39"
	},
	"scripts": {
		"fix-style": "vendor/bin/php-cs-fixer fix",
		"check-style": "vendor/bin/php-cs-fixer fix --diff --dry-run",
		"test": "vendor/bin/phpunit"
	},
	"archive": {
		"exclude": [
			"/helpers",
			"/tests",
			"/js/src",
			"/js/tests",
			"/js/build.ts",
			"/js/package.json",
			"/js/package-lock.json",
			"/js/playwright.config.ts",
			"/js/tsconfig.json",
			"/js/vitest.config.ts"
		]
	}
}
